{
  "name": "enthalix",
  "version": "0.2.1",
  "private": true,
  "description": "BIM-BEM-BOM (Enthalix LLC): building models (IFC) into EnergyPlus energy models, compared with the building's measured operation",
  "license": "Apache-2.0",
  "author": {
    "name": "Enthalix LLC",
    "email": "342208247+Enthalix-dev@users.noreply.github.com"
  },
  "homepage": "https://github.com/Enthalix-llc/enthalix",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dist": "vite build && electron-builder --publish never",
    "setup:check": "node scripts/setupCheck.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@thatopen/components": "3.4.8",
    "@thatopen/fragments": "3.4.7",
    "@types/earcut": "^3.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.11.6",
    "camera-controls": "^3.1.2",
    "concurrently": "^9.1.0",
    "earcut": "^3.0.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.185.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "web-ifc": "0.0.77"
  },
  "build": {
    "appId": "com.enthalix.app",
    "productName": "BIM-BEM-BOM",
    "copyright": "Copyright 2026 Enthalix LLC",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "../references",
        "to": "references"
      },
      {
        "from": "../samples",
        "to": "samples"
      }
    ],
    "mac": {
      "target": "dmg",
      "artifactName": "BIM-BEM-BOM-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BIM-BEM-BOM-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "maintainer": "Enthalix LLC <342208247+Enthalix-dev@users.noreply.github.com>",
      "executableName": "bim-bem-bom",
      "artifactName": "BIM-BEM-BOM-${version}.${ext}"
    },
    "deb": {
      "artifactName": "bim-bem-bom_${version}_${arch}.${ext}"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
