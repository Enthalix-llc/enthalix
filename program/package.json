{
  "name": "enthalix",
  "version": "0.1.0",
  "private": true,
  "description": "Enthalix: building models (IFC) into EnergyPlus energy models, compared with the building's measured operation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dist": "vite build && electron-builder --mac dmg",
    "setup:check": "node scripts/setupCheck.mjs"
  },
  "dependencies": {
    "@thatopen/components": "3.4.8",
    "@thatopen/fragments": "3.4.7",
    "@xyflow/react": "^12.11.6",
    "camera-controls": "^3.1.2",
    "earcut": "^3.0.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.14.2",
    "three": "0.185.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.enthalix.app",
    "productName": "Enthalix",
    "copyright": "Copyright 2026 Enthalix LLC",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "target": "dmg"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
